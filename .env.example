# Конфигурация «Цифрового наследия» (раздел 3.4.1 Архитектура.md).
# Скопируйте в .env и сгенерируйте SECRET_KEY и MASTER_KEY (см. README).
# Файл .env не попадает в Git.

# Окружение: dev, test или prod.
APP_ENV=dev
# Базовый адрес для ссылок в письмах. В prod — https://ваш-домен (по нему же Caddy выпускает сертификат).
BASE_URL=http://localhost:8000

# Подпись сессий и токенов ссылок, не короче 32 символов. Обязательна.
SECRET_KEY=
# Мастер-ключ шифрования: base64 от 32 случайных байт. Обязателен.
# Храните копию минимум в двух независимых местах: без него данные не восстановить.
MASTER_KEY=

# Пароль пользователя PostgreSQL в контейнере db (используется docker compose).
# Должен совпадать с паролем в DATABASE_URL и TEST_DATABASE_URL. В prod замените.
POSTGRES_PASSWORD=app
# Строка подключения PostgreSQL. Обязательна.
DATABASE_URL=postgresql+psycopg://app:app@db:5432/app
# База app_test для тестов (создаётся docker/db-init.sql).
TEST_DATABASE_URL=postgresql+psycopg://app:app@db:5432/app_test

# Каталог тома files (зашифрованные файлы записей и документы).
FILES_DIR=/data/files
# Флаг Secure у cookie. В prod обязательно true.
COOKIE_SECURE=false
# Срок сессии Владельца, часы.
SESSION_TTL_HOURS=12
# Срок сессии Наследника, минуты.
HEIR_SESSION_TTL_MINUTES=30
# Срок ссылки подтверждения email, часы.
VERIFY_TOKEN_TTL_HOURS=48

# Отправка писем: smtp, memory (тесты) или console (отладка: письма печатаются в stdout).
EMAIL_BACKEND=smtp
# Адрес SMTP-сервера. В разработке — Mailpit (веб-интерфейс http://localhost:8025).
SMTP_HOST=mailpit
SMTP_PORT=1025
# Учётные данные SMTP (пусто — без аутентификации).
SMTP_USER=
SMTP_PASSWORD=
# Отправитель писем.
SMTP_FROM=no-reply@localhost
# Использовать STARTTLS.
SMTP_STARTTLS=false
# Тайм-аут SMTP, секунды.
SMTP_TIMEOUT_SECONDS=10

# Распознавание: easyocr или fake (только для тестов).
OCR_PROVIDER=easyocr
# Языки EasyOCR (веса скачиваются при сборке образа).
OCR_LANGS=ru,en
# Попыток OCR до отклонения с OCR_UNAVAILABLE.
OCR_MAX_ATTEMPTS=3
# Максимальная сторона изображения перед распознаванием, px.
OCR_MAX_IMAGE_SIDE=2000
# Разрешение рендеринга первой страницы PDF.
PDF_RENDER_DPI=200
# Порог нечёткого сравнения правил проверки, 0–100.
RULE_FUZZY_THRESHOLD=85

# Период ожидания после уведомления Владельца, секунды (14 дней).
WAITING_PERIOD_SECONDS=1209600
# Напоминание до окончания периода, секунды (3 дня). 0 < значение < WAITING_PERIOD_SECONDS.
REMINDER_BEFORE_SECONDS=259200
# Интервал цикла Worker, секунды (не больше 30).
WORKER_POLL_SECONDS=10
# Возраст heartbeat Worker, после которого /healthz возвращает 503, секунды.
WORKER_STALE_SECONDS=60

# Лимиты MVP (1.1.2).
# Записей на Владельца (текст и файлы вместе).
MAX_RECORDS=50
# Наследников на Владельца.
MAX_HEIRS=5
# Длина текста записи, символов.
MAX_TEXT_CHARS=10000
# Размер одного файла записи, МБ.
MAX_FILE_MB=10
# Общий объём файлов Владельца, МБ.
MAX_STORAGE_MB=100
# Размер документа о смерти, МБ.
MAX_DOC_MB=10
# Запросов по одному ключу за 24 часа.
HEIR_REQUESTS_PER_DAY=3

# Часовой пояс отображения дат и правил проверки документа.
DISPLAY_TZ=Europe/Moscow
